# Untrained base model with enough context for LaserMCP's full grammar prompt.
#   ollama pull phi4-mini
#   ollama create lasermcp-teacher -f tools/local_model/Modelfile.teacher
# Any chat model that fits your GPU works: change FROM and re-create.
FROM phi4-mini
PARAMETER num_ctx 8192
PARAMETER temperature 0.5
PARAMETER num_predict 2500
