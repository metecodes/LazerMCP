# Public site
MCP_PUBLIC_BASE_URL=https://mcp.metehanavci.com
MCP_HOST=127.0.0.1
MCP_PORT=8000

# production | development. Vercel sets VERCEL=1 which also counts as production.
# MCP_ENV=production

# Optional admin override. Never used as the session HMAC secret.
# MCP_AUTH_TOKEN=

# Required in production. Independent random secret. Never the Supabase anon key.
MCP_SESSION_SECRET=

# Durable app metadata + private objects. On Vercel, /tmp is ephemeral — set these
# or use Supabase service role + Storage (see docs/productization/DEPLOYMENT_CHECKLIST.md).
# MCP_DATA_DIR=
# MCP_OUTPUT_DIR=

# Supabase (Google sign-in). Do not commit real keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# New dashboard keys also work:
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Never expose to the browser. Needed for Postgres + private Storage.
# SUPABASE_SERVICE_ROLE_KEY=
# LASERMCP_STORAGE_BUCKET=lasermcp-artifacts

# Required to mint organization API keys. Unset = nobody can mint keys.
LASERMCP_ORG_DOMAINS=payas.edu.tr,example.com
# Extra OAuth redirect hosts. chatgpt.com, claude.ai, cursor.com are built in.
# LASERMCP_OAUTH_REDIRECT_HOSTS=
