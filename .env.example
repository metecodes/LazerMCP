# Public site
MCP_PUBLIC_BASE_URL=https://mcp.metehanavci.com
MCP_HOST=127.0.0.1
MCP_PORT=8000

# production | development. Vercel sets VERCEL=1 which also counts as production.
# MCP_ENV=production

# Optional admin override. Never used as the session HMAC secret.
# MCP_AUTH_TOKEN=

# Required in production. Independent random secret. Never the Supabase anon key.
MCP_SESSION_SECRET=

# Durable app metadata + private objects. On Vercel, /tmp is ephemeral — set these
# or use Supabase service role + Storage (see docs/productization/DEPLOYMENT_CHECKLIST.md).
# MCP_DATA_DIR=
# MCP_OUTPUT_DIR=

# Supabase (Google sign-in). Do not commit real keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# New dashboard keys also work:
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Never expose to the browser. Needed for Postgres + private Storage.
# SUPABASE_SERVICE_ROLE_KEY=
# LASERMCP_STORAGE_BUCKET=lasermcp-artifacts

# Operator panel /admin. metehan1387@gmail.com is always included.
# LASERMCP_ADMIN_EMAILS=metehan1387@gmail.com

# Required to mint organization API keys by email domain. Admin grant is a second path.
LASERMCP_ORG_DOMAINS=payas.edu.tr,example.com
# Extra OAuth redirect hosts. chatgpt.com, claude.ai, cursor.com are built in.
# LASERMCP_OAUTH_REDIRECT_HOSTS=

# Workshop LLM keys (OpenAI / Anthropic) — NOT LaserMCP lzr_ platform keys.
# Prefer Account → LLM UI (admin). Env is the single-tenant fallback.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional encryptor for stored keys (defaults to MCP_SESSION_SECRET):
# LASERMCP_SECRETS_KEY=

# Cost guards for those keys. Only approved signed-in accounts reach the provider;
# everyone else, and anything over a cap, is served by the free local planner.
# Model Studio AI calls when the request names none or one outside the list:
# LASERMCP_LLM_DEFAULT_MODEL=gpt-4o-mini
# Models Studio AI may call (comma list; the default above is always included):
# LASERMCP_LLM_MODELS=gpt-4o-mini,gpt-4o,claude-haiku-4.5,claude-sonnet-4.5
# Provider calls per address / for the whole site, per 24 h (0 = none):
# LASERMCP_AI_DAILY_PER_IP=10
# LASERMCP_AI_DAILY_GLOBAL=200
# Most output tokens one call may bill:
# LASERMCP_LLM_MAX_OUTPUT_TOKENS=2500
